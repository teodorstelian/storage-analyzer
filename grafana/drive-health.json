{
  "uid": "drive-health",
  "title": "Drive Health",
  "schemaVersion": 41,
  "version": 1,
  "tags": [
    "storage",
    "rig-pulse"
  ],
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 100,
      "title": "Collection status and scan freshness",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Drive Health scans every 5 minutes while running. Missing sensors are omitted. Charts hide failed scans and readings older than 15 minutes. Windows health is not a failure prediction. Check Prometheus target **drive-health** if all charts are empty. SQLite history is not backfilled."
      }
    },
    {
      "id": 1,
      "title": "Temperature",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "drive_health_temperature_celsius{job=\"drive-health\"} and on(job,instance) (drive_health_scan_success == 1) and on(job,instance) (time() - drive_health_scan_timestamp_seconds < 900)",
          "legendFormat": "{{name}} · {{drive}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Rated life used",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "drive_health_wear_percent{job=\"drive-health\"} and on(job,instance) (drive_health_scan_success == 1) and on(job,instance) (time() - drive_health_scan_timestamp_seconds < 900)",
          "legendFormat": "{{name}} · {{drive}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
